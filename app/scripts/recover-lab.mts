import fs from "node:fs";
import sharp from "sharp";
import { createWorker } from "tesseract.js";
import { buildLines, mergePasses, rawFromTesseract, withUnderlines, type RawWord } from "../src/modules/scan/layout";
import { recoverMissing } from "../src/modules/scan/recover";
import { underlineDetail, type TraceContext } from "../src/modules/scan/underline";
const f = process.argv[2] ?? "IMG_0623.jpg", dir = "../bench/data/real-norm";
const TPS: Record<string, string[]> = { "IMG_0623.jpg": ["arranged", "parting", "injunctions", "bearing", "concerning", "inquiries", "certain", "elderly", "gentleman", "amiable", "moor", "cruel", "injustice", "preserve", "groom", "moorland", "farmers", "whom", "folk", "precautions", "imprudent", "misfortune"] };
const TP = TPS[f] ?? [];
const norm = (s: string) => s.replace(/[^A-Za-z]/g, "").toLowerCase();
const { data, info } = await sharp(`${dir}/${f}`).resize({ width: 1800 }).grayscale().raw().toBuffer({ resolveWithObject: true });
const W = info.width, H = info.height;
const gray = new Uint8Array(W * H).map((_, i) => data[i * info.channels]);
const grayBuf = await sharp(`${dir}/${f}`).resize({ width: 1800 }).grayscale().toBuffer();
const words0 = buildLines(mergePasses(JSON.parse(fs.readFileSync(`../bench/data/ocr-cache/${f}.json`, "utf8")) as RawWord[][]));
const marked = withUnderlines(gray, W, H, words0);
let ctx!: TraceContext;
underlineDetail(gray, W, H, words0, { hook: (c) => (ctx = c) });
const worker = await createWorker("eng");
await worker.setParameters({ tessedit_pageseg_mode: "7" as never });
const t0 = Date.now();
const res = await recoverMissing(marked, ctx, async (b) => {
  const buf = await sharp(grayBuf).extract({ left: b.x0, top: b.y0, width: b.x1 - b.x0, height: b.y1 - b.y0 }).extend({ top: 8, bottom: 10, left: 10, right: 10, background: "#dcdcdc" }).resize({ width: (b.x1 - b.x0 + 20) * 2 }).jpeg({ quality: 92 }).toBuffer();
  const { data: o } = await worker.recognize(buf, {}, { blocks: true });
  return rawFromTesseract(o as never).map((r) => ({ ...r, x: b.x0 - 10 + r.x / 2, y: b.y0 - 8 + r.y / 2, w: r.w / 2, h: r.h / 2 }));
});
console.log(`възстановяване: ${((Date.now() - t0) / 1000).toFixed(1)}s; добавени: ${res.added.join(" | ") || "—"}`);
const before = TP.filter((t) => marked.some((w) => w.auto && norm(w.t) === t));
const after = TP.filter((t) => res.words.some((w) => w.auto && norm(w.t) === t));
console.log(`маркирани подчертани преди: ${before.length}/${TP.length}; след: ${after.length}/${TP.length}; липсват: ${TP.filter((t) => !after.includes(t)).join(" ")}`);
console.log(`общо маркирани: ${marked.filter((w) => w.auto).length} → ${res.words.filter((w) => w.auto).length}`);
await worker.terminate();
